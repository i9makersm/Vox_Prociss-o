# Opcional. Se nao preencher, o app usa automaticamente o dominio publico da hospedagem.
# Exemplo: https://vox-procissao.onrender.com
PUBLIC_APP_URL=

# LiveKit Cloud e a opcao recomendada para colocar no ar rapido.
# Pegue estes dados no painel do LiveKit Cloud.
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=sua_api_key
LIVEKIT_API_SECRET=sua_api_secret

PORT=3000

# Para teste publico no Render, o render.yaml cria o Postgres Free automaticamente.
DATABASE_URL=postgres://usuario:senha@host:5432/vox_procissao

# Opcional. Use Redis quando for escalar para mais de uma instancia.
REDIS_URL=

# Fallback se DATABASE_URL nao existir: use pasta persistente em disco.
DATA_DIR=/app/data
